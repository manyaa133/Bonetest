# Application
APP_NAME=Bone Age Predictor API
APP_VERSION=1.0.0
DEBUG=true

# Paths (relative to backend/)
CHECKPOINT_DIR=checkpoints
METRICS_DIR=metrics
UPLOAD_DIR=uploads
RF_MODELS_DIR=rf_models

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inference
IMAGE_SIZE=512
DEVICE=cpu
DEFAULT_MODEL=cnn

# Normalization (dataset statistics — update after training)
NORM_MEAN=0.4523
NORM_STD=0.2118
